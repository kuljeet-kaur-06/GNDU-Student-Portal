# Server-only configuration. Copy this file to server/.env; never commit that file.
NODE_ENV=development
PORT=8080
DATABASE_URL="file:./dev.db"
FRONTEND_ORIGIN=http://localhost:5173
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1h

# Used only by `npm run admin:create`; do not put these in the frontend .env file.
INITIAL_ADMIN_NAME=Local Administrator
INITIAL_ADMIN_USERNAME=admin-local
INITIAL_ADMIN_PASSWORD=replace-with-a-long-unique-temporary-password
